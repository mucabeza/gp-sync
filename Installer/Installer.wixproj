<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputName>MaxSfGpSync</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressIces>ICE80</SuppressIces>
    <PublishOutputDir>$(MSBuildThisFileDirectory)..\publish\win-x64</PublishOutputDir>
    <DefineConstants>$(DefineConstants);PublishOutputDir=$(PublishOutputDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="4.0.5" />
  </ItemGroup>

  <ItemGroup>
    <HarvestDirectory Include="$(PublishOutputDir)">
      <ComponentGroupName>AppFiles</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <PreprocessorVariable>var.PublishOutputDir</PreprocessorVariable>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
  </ItemGroup>

  <Target Name="PublishApplication" BeforeTargets="Build">
    <Exec Command='dotnet publish "$(MSBuildThisFileDirectory)..\SalesforceDynamicsGpIntegration.csproj" -c Release -p:PublishProfile=WinX64FrameworkDependent' />
  </Target>
</Project>
